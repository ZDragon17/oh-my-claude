{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "provider/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "oh-my-opencode"
  ]
}
