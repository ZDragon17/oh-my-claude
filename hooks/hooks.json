{
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": "bash hooks/ralph-loop.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "Ralph Loop - 自引用循环控制（检测完成承诺）"
      },
      {
        "type": "command",
        "command": "bash hooks/todo-continuation.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "TODO 续航检查 - 如果有活跃循环则阻止停止"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "bash hooks/keyword-detector.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "关键词检测 - 自动触发相关模式（包括 ultrawork/移山）"
      },
      {
        "type": "command",
        "command": "bash hooks/agent-collaboration.sh",
        "timeout": 5000,
        "continueOnError": true,
        "description": "多 Agent 协作 - 检测和启动协作"
      },
      {
        "type": "command",
        "command": "bash hooks/task-checkpointing.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "任务检查点 - 记录任务状态用于恢复"
      },
      {
        "type": "command",
        "command": "bash hooks/context-compression.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "上下文压缩 - 智能信息压缩"
      },
      {
        "type": "command",
        "command": "bash hooks/error-recovery.sh",
        "timeout": 5000,
        "continueOnError": true,
        "description": "错误恢复 - 自动检测和恢复策略"
      },
      {
        "type": "command",
        "command": "bash hooks/preemptive-compaction.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "抢占式压缩 - 在达到限制前主动压缩"
      },
      {
        "type": "command",
        "command": "bash hooks/lsp-tools.sh",
        "timeout": 5000,
        "continueOnError": true,
        "description": "LSP 工具 - 提供 IDE 级代码分析能力"
      },
      {
        "type": "command",
        "command": "bash hooks/ast-grep.sh",
        "timeout": 5000,
        "continueOnError": true,
        "description": "AST-Grep - 结构化代码搜索"
      },
      {
        "type": "command",
        "command": "bash hooks/code-quality-checker.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "代码质量检查 - 注释和风格验证"
      },
      {
        "type": "command",
        "command": "bash hooks/output-truncator.sh",
        "timeout": 2000,
        "continueOnError": true,
        "description": "输出截断器 - 智能截断大型输出"
      },
      {
        "type": "command",
        "command": "bash hooks/directory-agents-injector.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "目录代理注入 - 根据目录推荐 Agent"
      },
      {
        "type": "command",
        "command": "bash hooks/rules-injector.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "规则注入 - 加载项目和全局规则"
      },
      {
        "type": "command",
        "command": "bash hooks/think-mode.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "思维模式 - 深度思考和推理增强"
      },
      {
        "type": "command",
        "command": "bash hooks/auto-update-checker.sh",
        "timeout": 5000,
        "continueOnError": true,
        "description": "自动更新检查 - 检查新版本"
      },
      {
        "type": "command",
        "command": "bash hooks/session-recovery.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "会话恢复 - 检测会话中断信号并提供恢复策略"
      },
      {
        "type": "command",
        "command": "bash hooks/interactive-bash-session.sh",
        "timeout": 2000,
        "continueOnError": true,
        "description": "交互式 Bash 会话 - 检测长时间运行进程并建议使用 tmux"
      },
      {
        "type": "command",
        "command": "bash hooks/agent-usage-reminder.sh",
        "timeout": 2000,
        "continueOnError": true,
        "description": "Agent 使用提醒 - 根据任务类型推荐合适的 Agent"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash hooks/output-truncator.sh",
        "timeout": 2000,
        "continueOnError": true,
        "description": "工具输出截断 - 处理大型工具输出"
      },
      {
        "type": "command",
        "command": "bash hooks/delegate-task-retry.sh",
        "timeout": 5000,
        "continueOnError": true,
        "description": "任务委派重试 - 检测失败的委派任务并提供重试建议"
      },
      {
        "type": "command",
        "command": "bash hooks/background-notification.sh",
        "timeout": 3000,
        "continueOnError": true,
        "description": "后台任务通知 - 检测完成的后台任务并发送通知"
      },
      {
        "type": "command",
        "command": "bash hooks/empty-task-response-detector.sh",
        "timeout": 2000,
        "continueOnError": true,
        "description": "空任务响应检测 - 检测委派任务的空响应或无效响应"
      },
      {
        "type": "command",
        "command": "bash hooks/context-window-monitor.sh",
        "timeout": 2000,
        "continueOnError": true,
        "description": "上下文窗口监控 - 监控上下文使用率并提供预警"
      },
      {
        "type": "command",
        "command": "bash hooks/tool-output-validator.sh",
        "timeout": 2000,
        "continueOnError": true,
        "description": "工具输出验证 - 检测工具执行错误并提供修复建议"
      },
      {
        "type": "command",
        "command": "bash hooks/thinking-block-validator.sh",
        "timeout": 2000,
        "continueOnError": true,
        "description": "思维块验证 - 检测 extended thinking 相关错误"
      }
    ]
  },
  "disabled_hooks": [],
  "hook_config": {
    "parallel_execution": false,
    "log_enabled": true,
    "log_path": "$HOME/.oh-my-claude/logs/hooks.log"
  },
  "v2_migration": {
    "note": "v2.0 循环机制变更说明 - 已完成迁移",
    "status": "completed",
    "completed_at": "2026-01-19",
    "changes": [
      "Stop hooks 不再使用外部脚本检测完成状态",
      "循环机制通过 Agent System Prompt 和 Skill 规范实现",
      "关键词触发由 keyword-detector.sh 处理",
      "TODO 强制执行通过 Agent 行为规范确保"
    ],
    "deprecated_files_cleaned": true
  }
}
