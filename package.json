{
  "name": "claude-pangu",
  "version": "1.0.11",
  "description": "基于中国传统文化的 Claude Code 智能编排插件 - A Claude Code plugin inspired by Chinese traditional culture (原名 oh-my-claude)",
  "keywords": [
    "claude-code",
    "claude",
    "pangu",
    "oh-my-claude",
    "agent",
    "orchestration",
    "chinese-culture",
    "multi-agent",
    "productivity",
    "automation"
  ],
  "author": "ZDragon17",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZDragon17/oh-my-claude.git"
  },
  "bugs": {
    "url": "https://github.com/ZDragon17/oh-my-claude/issues"
  },
  "homepage": "https://github.com/ZDragon17/oh-my-claude#readme",
  "bin": {
    "claude-pangu": "./scripts/cli.mjs",
    "oh-my-claude": "./scripts/cli.mjs"
  },
  "files": [
    "agents/",
    "commands/",
    "hooks/",
    "skills/",
    ".claude-plugin/",
    "scripts/",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist/ coverage/",
    "install-plugin": "ts-node scripts/cli.ts install",
    "uninstall-plugin": "ts-node scripts/cli.ts uninstall",
    "postinstall": "node scripts/postinstall.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "ci": "npm run type-check && npm run lint && npm run test:coverage",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^25.0.9",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^3.22.4"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
