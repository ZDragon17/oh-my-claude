{
  "name": "learn",
  "version": "1.0.0",
  "description": "项目学习技能 - 自动分析项目，生成项目画像",
  "keywords": ["learn", "analyze", "profile", "project", "学习", "分析"],
  "author": "ZDragon17",
  "license": "MIT",
  "repository": "https://github.com/ZDragon17/oh-my-claude",

  "commandAliases": {
    "/learn": ["/学习", "/analyze", "/profile"]
  },

  "subcommands": {
    "project": "分析当前项目",
    "refresh": "刷新项目画像",
    "show": "显示当前画像"
  },

  "outputPath": ".oh-my-claude/project-profile.md",

  "analysisPhases": {
    "structure": {
      "name": "项目结构扫描",
      "icon": "📁",
      "timeout": 30000
    },
    "techStack": {
      "name": "技术栈识别",
      "icon": "🔍",
      "timeout": 20000
    },
    "documentation": {
      "name": "文档阅读",
      "icon": "📖",
      "timeout": 30000
    },
    "patterns": {
      "name": "代码模式分析",
      "icon": "🧩",
      "timeout": 40000
    }
  },

  "detectionRules": {
    "packageManagers": {
      "package.json": "npm/yarn/pnpm",
      "requirements.txt": "pip",
      "pyproject.toml": "poetry/pip",
      "go.mod": "go modules",
      "Cargo.toml": "cargo",
      "pom.xml": "maven",
      "build.gradle": "gradle",
      "composer.json": "composer"
    },
    "frameworks": {
      "react": ["react", "react-dom"],
      "vue": ["vue"],
      "angular": ["@angular/core"],
      "nextjs": ["next"],
      "nuxt": ["nuxt"],
      "express": ["express"],
      "nestjs": ["@nestjs/core"],
      "fastapi": ["fastapi"],
      "django": ["django"],
      "flask": ["flask"],
      "gin": ["gin-gonic/gin"],
      "spring": ["spring-boot"]
    },
    "stateManagement": {
      "zustand": ["zustand"],
      "redux": ["redux", "@reduxjs/toolkit"],
      "mobx": ["mobx"],
      "pinia": ["pinia"],
      "vuex": ["vuex"],
      "jotai": ["jotai"],
      "recoil": ["recoil"]
    },
    "testing": {
      "jest": ["jest"],
      "vitest": ["vitest"],
      "mocha": ["mocha"],
      "pytest": ["pytest"],
      "playwright": ["@playwright/test"],
      "cypress": ["cypress"]
    }
  },

  "profileSections": [
    "基本信息",
    "技术栈",
    "项目结构",
    "代码规范",
    "关键模块",
    "最近活动",
    "Agent 建议"
  ],

  "refreshThreshold": {
    "days": 7,
    "majorChangeFiles": ["package.json", "requirements.txt", "go.mod"]
  },

  "agentRecommendations": {
    "react": { "coder": "luban", "architect": "zhuge", "tester": "baozheng" },
    "vue": { "coder": "luban", "architect": "zhuge", "tester": "baozheng" },
    "nextjs": { "coder": "luban", "architect": "zhuge", "tester": "baozheng" },
    "python": { "coder": "luban", "architect": "zhuge", "tester": "baozheng" },
    "go": { "coder": "luban", "architect": "zhuge", "tester": "baozheng" },
    "rust": { "coder": "luban", "architect": "zhuge", "tester": "baozheng" }
  }
}
